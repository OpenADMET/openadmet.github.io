{{/*
  Lists every published post on Ghost on /blog, fetched from the Content API at
  build time, so new posts and edits show up on the next build.

  Posts are read on Ghost, not here, so Ghost's analytics count every read:
  each card links to the post on Ghost (the "link" param). The /blog/<slug>/
  page each post still gets (layouts/blog/single.html) is only a redirect to
  Ghost, kept so links to the on-site copies we hosted in Oct 2026 still work.

  External-link posts are stubs on Ghost that forward to an article hosted
  elsewhere: an empty body (Ghost redirects the URL) or an HTML card with a meta
  refresh. Their card links straight to the destination, and they get no page.

  If Ghost can't be reached the build fails, so the live blog is left as it was
  rather than replaced with an empty one.
*/}}

{{ if not site.Params.ghostContentKey }}
  {{ errorf "No Ghost Content API key. Set HUGO_PARAMS_GHOSTCONTENTKEY (a repo secret in CI; see README) to build the blog." }}
{{ end }}

{{ $api := printf "%sghost/api/content/posts/?key=%s&limit=all&include=tags&formats=html" site.Params.ghostSite site.Params.ghostContentKey }}
{{ $posts := slice }}
{{ with try (resources.GetRemote $api) }}
  {{ with .Err }}
    {{ errorf "Ghost Content API unreachable (%s). Failing the build so the live blog is left untouched rather than emptied." . }}
  {{ else with .Value }}
    {{ $posts = (. | transform.Unmarshal).posts }}
  {{ end }}
{{ end }}
{{ if not $posts }}
  {{ errorf "Ghost Content API returned no posts. Failing the build so the live blog is left untouched rather than emptied." }}
{{ end }}

{{ $refreshRE := `<meta http-equiv="refresh" content="\d+;\s*url=([^"]+)"` }}

{{ range $posts }}
  {{ $html := .html | default "" }}
  {{ $external := "" }}
  {{ with findRESubmatch $refreshRE $html 1 }}
    {{ $external = index (index . 0) 1 }}
  {{ else }}
    {{ if not (strings.TrimSpace $html) }}{{ $external = .url }}{{ end }}
  {{ end }}

  {{ $tag := "" }}
  {{ with .primary_tag }}{{ $tag = .name }}{{ end }}

  {{ $page := dict
    "path" .slug
    "title" .title
    "dates" (dict "date" (time.AsTime .published_at) "lastmod" (time.AsTime .updated_at))
    "params" (dict
      "link" ($external | default .url)
      "excerpt" (.custom_excerpt | default .excerpt | default "" | plainify | strings.ReplaceRE `\s+` " " | strings.TrimSpace)
      "featureImage" (.feature_image | default "")
      "tag" $tag
    )
    "sitemap" (dict "disable" true)
  }}
  {{ if $external }}
    {{ $page = merge $page (dict "build" (dict "render" "never" "list" "always")) }}
  {{ end }}
  {{ $.AddPage $page }}
{{ end }}
